{
  "name": "applicationbuilder",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@material-ui/core": "^4.9.10",
    "@material-ui/icons": "^4.5.1",
    "@material-ui/lab": "^4.0.0-alpha.49",
    "@testing-library/jest-dom": "^4.2.4",
    "axios": "^0.19.2",
    "chart.js": "^2.9.3",
    "d3": "^5.15.0",
    "http-server": "^0.12.3",
    "list-react-files": "^0.2.0",
    "react": "^16.12.0",
    "react-color": "^2.18.1",
    "react-dom": "^16.12.0",
    "react-google-charts": "^3.0.15",
    "react-rnd": "^10.1.5",
    "react-scripts": "^2.1.8"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/tailwind.css --watch",
    "start": "npm run build:css && concurrently -k -n css,app -c teal,cyan \"npm run watch:css\" \"NODE_OPTIONS=--openssl-legacy-provider react-scripts start\"",
    "build": "npm run build:css && NODE_OPTIONS=--openssl-legacy-provider react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
